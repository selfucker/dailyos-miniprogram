.page { padding: 16rpx 28rpx 40rpx; }
.meta { padding: 8rpx 4rpx 20rpx; }
.date { font-size: 24rpx; color: var(--color-muted); }

.block {
  background-color: var(--color-surface);
  border: 1rpx solid var(--color-border);
  border-radius: var(--radius-card);
  padding: 24rpx 28rpx;
  margin-bottom: var(--space-card);
}
.block.soft {
  background-color: transparent;
  border: none;
  padding: 4rpx;
}
.block-title {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--color-ink);
  margin-bottom: 16rpx;
}
.block-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 16rpx;
}
.block-head .block-title { margin-bottom: 0; }
.block-action {
  font-size: 24rpx;
  color: var(--color-brand);
  padding: 4rpx 16rpx;
  border: 1rpx solid var(--color-brand);
  border-radius: 999rpx;
  background: transparent;
}

.row { display: flex; align-items: center; }
.row.mt { margin-top: 16rpx; }
.label { width: 96rpx; font-size: 26rpx; color: var(--color-muted); }
.value { font-size: 28rpx; color: var(--color-ink); }
.value.strong { font-weight: 600; color: var(--color-brand, #2D5F3F); }

.chips { display: flex; flex-wrap: wrap; gap: 12rpx; flex: 1; }
.chip {
  padding: 8rpx 20rpx;
  border-radius: 999rpx;
  border: 1rpx solid var(--color-border);
  font-size: 24rpx;
  color: var(--color-muted);
  transition: background-color 160ms ease, color 160ms ease, border-color 160ms ease, transform 120ms ease;
}
.chip-hover {
  transform: scale(0.94);
  background-color: var(--color-brand);
  color: #FFFFFF;
  border-color: var(--color-brand);
}
.chip-on {
  background-color: var(--color-brand-soft);
  color: var(--color-brand);
  border-color: var(--color-brand);
  font-weight: 500;
}

.meal-row {
  display: flex;
  align-items: center;
  padding: 16rpx 0;
  border-bottom: 1rpx solid var(--color-divider);
}
.meal-row:last-child { border-bottom: none; }
.meal-row.total {
  border-top: 1rpx solid var(--color-divider);
  margin-top: 8rpx;
  padding-top: 16rpx;
}
.meal-type { width: 144rpx; font-size: 26rpx; color: var(--color-ink); }
.meal-kcal { width: 140rpx; font-size: 26rpx; color: var(--color-ink); font-weight: 600; }
.meal-macros { flex: 1; font-size: 22rpx; color: var(--color-muted); text-align: right; }
.muted { color: var(--color-muted); font-size: 24rpx; }

.metric-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.metric {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 8rpx 0;
}
.metric-label {
  font-size: 24rpx;
  color: var(--color-muted);
  margin-bottom: 12rpx;
}
.metric-value {
  display: flex;
  align-items: baseline;
  justify-content: center;
  font-size: 48rpx;
  font-weight: 600;
  color: var(--color-ink);
  line-height: 1.1;
}
.metric-number {
  font-size: 48rpx;
  font-weight: 600;
  color: var(--color-ink);
}
.metric-unit {
  font-size: 24rpx;
  color: var(--color-muted);
  margin-left: 4rpx;
  font-weight: 400;
}
.metric-delta {
  font-size: 22rpx;
  margin-top: 12rpx;
  color: var(--color-muted);
}
.metric-delta.down { color: var(--color-brand, #2D5F3F); }
.metric-delta.up { color: #C77700; }
.metric-divider {
  width: 1rpx;
  height: 96rpx;
  background: var(--color-divider);
}

.trend-meta {
  display: flex;
  gap: 24rpx;
  margin-bottom: 16rpx;
}
.trend-stat {
  font-size: 22rpx;
  color: var(--color-muted);
}
.trend-canvas-wrap {
  width: 100%;
  height: 320rpx;
}
.trend-canvas {
  width: 100%;
  height: 320rpx;
}
.trend-axis {
  display: flex;
  justify-content: space-between;
  padding: 8rpx 4rpx 0;
}
.trend-tick {
  font-size: 20rpx;
  color: var(--color-muted);
  flex: 1;
  text-align: center;
}
.trend-tick:first-child { text-align: left; }
.trend-tick:last-child { text-align: right; }

.cta-wrap { margin-top: 24rpx; }
.cta-btn {
  height: 96rpx;
  border-radius: 48rpx;
  background-color: var(--color-brand);
  color: #FFFFFF;
  text-align: center;
  line-height: 96rpx;
  font-size: 30rpx;
  font-weight: 500;
}

/* 录入弹层 */
.sheet-mask {
  position: fixed;
  inset: 0;
  background: rgba(0, 0, 0, 0.42);
  display: flex;
  align-items: flex-end;
  justify-content: center;
  z-index: 100;
}
.sheet {
  width: 100%;
  background: var(--color-bg, #F8F5EE);
  border-radius: 24rpx 24rpx 0 0;
  padding: 16rpx 32rpx 48rpx;
  box-sizing: border-box;
}
.sheet-handle {
  width: 64rpx;
  height: 8rpx;
  border-radius: 4rpx;
  background: var(--color-border);
  margin: 0 auto 16rpx;
}
.sheet-title {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--color-ink);
  margin: 8rpx 0 24rpx;
  text-align: center;
}
.form-row {
  display: flex;
  align-items: center;
  padding: 24rpx 28rpx;
  background: var(--color-surface, #FFFFFF);
  border: 1rpx solid var(--color-border);
  border-radius: 14rpx;
  margin-bottom: 16rpx;
}
.form-label {
  font-size: 28rpx;
  color: var(--color-ink);
  width: 220rpx;
}
.form-input {
  flex: 1;
  font-size: 30rpx;
  color: var(--color-ink);
  text-align: right;
  background: transparent;
  border: none;
  outline: none;
  padding: 0;
  margin: 0;
  height: 40rpx;
  line-height: 40rpx;
}
.form-input-placeholder {
  color: var(--color-muted);
  font-size: 26rpx;
}
.sheet-tip {
  font-size: 22rpx;
  color: var(--color-muted);
  text-align: center;
  margin: 8rpx 0 24rpx;
}
.sheet-actions {
  display: flex;
  gap: 16rpx;
}
.sheet-btn {
  flex: 1;
  height: 88rpx;
  line-height: 88rpx;
  border-radius: 44rpx;
  background: var(--color-brand);
  color: #FFFFFF;
  font-size: 28rpx;
  font-weight: 500;
  text-align: center;
}
.sheet-btn.ghost {
  background: transparent;
  border: 1rpx solid var(--color-border);
  color: var(--color-ink);
}
/* === 训练设置 / 餐次录入弹层 === */
.row-tap {
  position: relative;
}
.row-hover {
  background-color: rgba(196, 163, 90, 0.08);
}
.chip-group {
  display: flex;
  gap: 12rpx;
  flex-wrap: wrap;
}
.sheet-chip {
  padding: 12rpx 28rpx;
  border-radius: 999rpx;
  border: 1rpx solid var(--color-border);
  font-size: 26rpx;
  color: var(--color-ink);
  transition: background-color 160ms ease, color 160ms ease, border-color 160ms ease, transform 120ms ease;
}
.sheet-chip-hover {
  transform: scale(0.96);
  background-color: var(--color-brand-soft);
}
.sheet-chip-on {
  background-color: var(--color-brand);
  color: #FFFFFF;
  border-color: var(--color-brand);
  font-weight: 500;
}
.form-section {
  margin-top: 8rpx;
  margin-bottom: 16rpx;
}
.form-section-label {
  display: block;
  font-size: 24rpx;
  color: var(--color-muted);
  margin-bottom: 16rpx;
}
.sheet-title-wrap {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  margin: 8rpx 0 24rpx;
}
.sheet-title-wrap .sheet-title {
  margin: 0;
}
.sheet-clear {
  position: absolute;
  right: 0;
  font-size: 24rpx;
  color: var(--color-muted);
  padding: 4rpx 12rpx;
}
.sheet-clear:active {
  opacity: 0.5;
}
