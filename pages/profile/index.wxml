<view class="page">
  <view class="profile">
    <view class="avatar title-serif">{{ avatarText }}</view>
    <view class="info">
      <view class="name title-serif">{{ nickname }}</view>
      <view class="meta">连续 {{ streak }} 天 · 累计 {{ totalDays }} 天</view>
    </view>
  </view>

  <view class="stats">
    <view class="stat">
      <view class="stat-num title-serif">{{ englishDays }}</view>
      <view class="stat-label">英语天数</view>
    </view>
    <view class="stat">
      <view class="stat-num title-serif">{{ workoutDays }}</view>
      <view class="stat-label">健身天数</view>
    </view>
    <view class="stat">
      <view class="stat-num title-serif">{{ monthTotal }}</view>
      <view class="stat-label">本月支出</view>
    </view>
  </view>

  <view class="block-title">设置</view>
  <view class="block">
    <block wx:for="{{ settingItems }}" wx:key="key">
      <view class="setting-row" data-key="{{ item.key }}" bindtap="onTapSetting">
        <text class="set-label">{{ item.label }}</text>
        <text class="set-value">{{ item.value }}</text>
      </view>
    </block>
  </view>

  <view class="tip">备份是一个 JSON 文件，可发送到微信聊天长期保存；换手机后在新设备用「数据导入」恢复。</view>
</view>
