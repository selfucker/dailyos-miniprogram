/* pages/news/article/index.wxss */
.page {
  width: 100%;
  height: 100vh;
}

.fallback {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 64rpx 48rpx;
  background: #F8F5EE;
  min-height: 100vh;
  box-sizing: border-box;
}

.fb-icon {
  width: 96rpx;
  height: 96rpx;
  line-height: 96rpx;
  text-align: center;
  border-radius: 50%;
  background: rgba(196, 163, 90, 0.15);
  color: var(--accent, #C4A35A);
  font-size: 56rpx;
  font-weight: 600;
  margin-bottom: 24rpx;
}

.fb-title {
  font-size: 36rpx;
  font-weight: 600;
  color: var(--ink, #1A1714);
  margin-bottom: 12rpx;
}

.fb-desc {
  font-size: 26rpx;
  color: var(--ink-soft, #6B6660);
  text-align: center;
  line-height: 1.6;
  margin-bottom: 16rpx;
}

.fb-url {
  font-size: 22rpx;
  color: var(--ink-faint, #9C968D);
  word-break: break-all;
  text-align: center;
  margin-bottom: 32rpx;
  padding: 16rpx 24rpx;
  background: rgba(196, 163, 90, 0.08);
  border-radius: 8rpx;
  max-width: 100%;
  box-sizing: border-box;
}

.fb-btn {
  width: 320rpx;
  height: 80rpx;
  line-height: 80rpx;
  border-radius: 8rpx;
  background: var(--brand, #2D5F3F);
  color: #FFFFFF;
  font-size: 28rpx;
  font-weight: 500;
  margin: 12rpx 0;
  border: none;
}

.fb-btn.ghost {
  background: transparent;
  color: var(--brand, #2D5F3F);
  border: 1rpx solid var(--brand, #2D5F3F);
}