<view class="page">
  <view class="meta"><text class="date">{{ dateLabel }}</text></view>

  <!-- 词书选择：横向 scroll-view 用 view wx:for（不用 enhanced，避免框架层渲染异常） -->
  <scroll-view scroll-x class="book-strip">
    <view wx:for="{{ books }}" wx:key="id"
          class="book-item {{ bookId === item.id ? 'book-active' : '' }}"
          data-id="{{ item.id }}"
          bindtap="onSelectBook"
          hover-class="book-tap-hover"
          hover-start-time="0"
          hover-stay-time="180">
      <text class="book-title">{{ item.title }}</text>
      <text class="book-sub">{{ item.subtitle }}</text>
    </view>
  </scroll-view>

  <view class="hero">
    <view class="hero-title title-serif">{{ bookTitle }}</view>
    <view class="hero-sub">第 {{ dayIndex }} 天 · 连续 {{ streak }} 天</view>
  </view>

  <view class="counter">
    <text class="num title-serif">{{ done }} / {{ target }}</text>
  </view>
  <view class="bar"><progress-bar value="{{ progress }}" height="14"/></view>

  <view class="cta-wrap">
    <view class="cta-btn" bindtap="onTapStart">{{ ctaText }}</view>
    <!-- open-type="share" 触发本页 onShareAppMessage，把今天的打卡计划转发给好友 -->
    <button class="share-btn" open-type="share" hover-class="share-btn-hover">分享今日打卡给好友</button>
  </view>

  <view class="hint-line">
    <text wx:if="{{ done === 0 }}">点词书卡片切换；完成一组共 {{ target }} 词。</text>
    <text wx:elif="{{ done >= target }}">今日已完成 {{ target }} 词，明天继续。</text>
    <text wx:else>今日已学习 {{ done }} 词，点上方按钮继续。</text>
  </view>

  <view class="cal-card">
    <view class="cal-head">
      <text class="cal-title">{{ calTitle }}打卡</text>
      <text class="cal-stat">本月 {{ calMonthDays }} 天 · 连续 {{ streak }} 天 · 累计 {{ totalDays }} 天</text>
    </view>
    <view class="cal-week">
      <text>日</text><text>一</text><text>二</text><text>三</text><text>四</text><text>五</text><text>六</text>
    </view>
    <view class="cal-grid">
      <view class="cal-cell {{ item.checked ? 'on' : '' }} {{ item.today ? 'today' : '' }}"
            wx:for="{{ calCells }}"
            wx:key="key">
        <view class="cal-dot" wx:if="{{ item.day > 0 }}">{{ item.day }}</view>
      </view>
    </view>
  </view>

  <view class="wrong-entry"
        bindtap="onTapWrong"
        hover-class="wrong-entry-hover"
        hover-start-time="0"
        hover-stay-time="150">
    <text class="wrong-entry-label">错词本</text>
    <text class="wrong-entry-count">{{ wrongCount }} 个待复习</text>
    <text class="wrong-entry-arrow">›</text>
  </view>
</view>