/* pages/account/index.wxss */

.page { padding: 24rpx 28rpx 40rpx; }

/* —— 顶部金额（点击进 sheet） —— */
.amount {
  display: flex;
  align-items: baseline;
  justify-content: center;
  padding: 32rpx 0 12rpx;
}
.sym { font-size: 36rpx; color: var(--color-muted); margin-right: 12rpx; }
.num { font-size: 88rpx; color: var(--color-ink); font-weight: 600; line-height: 1; }

.center { text-align: center; }

/* —— 可点击行 hover —— */
.row-tap { transition: background-color 0.15s ease; }
.row-hover { background-color: var(--color-surface-hover, #F5F2EC); }

/* —— 通用 block / label / muted —— */
.block {
  background-color: var(--color-surface);
  border: 1rpx solid var(--color-border);
  border-radius: var(--radius-card);
  padding: 24rpx 28rpx;
  margin-bottom: var(--space-card);
}
.block-label {
  font-size: 26rpx;
  color: var(--color-muted);
  margin-bottom: 16rpx;
}
.muted { color: var(--color-muted); font-size: 24rpx; }
.mt { margin-top: 16rpx; }

/* —— 分类 chip（顶部 + sheet 内复用） —— */
.cats, .chips { display: flex; flex-wrap: wrap; gap: 16rpx; }
.cat, .chip {
  padding: 12rpx 24rpx;
  border-radius: 999rpx;
  border: 1rpx solid var(--color-border);
  font-size: 26rpx;
  color: var(--color-ink);
  background-color: var(--color-surface);
  transition: background-color 0.15s ease, color 0.15s ease, border-color 0.15s ease;
}
.cat-on, .chip-on {
  background-color: var(--color-brand);
  color: #FFFFFF;
  border-color: var(--color-brand);
}
.cat-hover, .chip-hover {
  background-color: var(--color-brand-soft);
  border-color: var(--color-brand);
}

/* —— 备注输入 —— */
.note-input {
  height: 64rpx;
  font-size: 28rpx;
  color: var(--color-ink);
  border-bottom: 1rpx solid var(--color-divider);
}

/* —— 今日列表项 —— */
.row-rec {
  display: flex;
  align-items: center;
  padding: 18rpx 0;
  border-bottom: 1rpx solid var(--color-divider);
}
.row-rec:last-of-type { border-bottom: none; }
.rec-cat {
  min-width: 60rpx;
  padding: 4rpx 12rpx;
  font-size: 22rpx;
  color: var(--color-brand);
  background-color: var(--color-brand-soft);
  border-radius: 999rpx;
  text-align: center;
  margin-right: 16rpx;
}
.rec-label { flex: 1; font-size: 26rpx; color: var(--color-ink); }
.rec-amt {
  font-size: 28rpx;
  color: var(--color-ink);
  font-variant-numeric: tabular-nums;
}
.rec-amt-in { color: var(--color-brand); }

/* —— sheet 弹层 —— */
.sheet-mask {
  position: fixed;
  top: 0; left: 0; right: 0; bottom: 0;
  background-color: rgba(0, 0, 0, 0.45);
  z-index: 1000;
  display: flex;
  align-items: flex-end;
}
.sheet {
  width: 100%;
  max-height: 92vh;
  background-color: var(--color-surface);
  border-top-left-radius: 24rpx;
  border-top-right-radius: 24rpx;
  padding: 16rpx 28rpx 40rpx;
  box-sizing: border-box;
  overflow-y: auto;
}
.sheet-handle {
  width: 56rpx;
  height: 6rpx;
  background-color: var(--color-divider);
  border-radius: 3rpx;
  margin: 0 auto 16rpx;
}
.sheet-title {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--color-ink);
  text-align: center;
  margin-bottom: 24rpx;
}

/* —— sheet 内金额显示 —— */
.amt-display {
  display: flex;
  align-items: baseline;
  justify-content: center;
  padding: 16rpx 0 24rpx;
  background-color: var(--color-bg, #FAF7F0);
  border-radius: var(--radius-card);
  margin-bottom: 24rpx;
}
.amt-sym { font-size: 36rpx; color: var(--color-muted); margin-right: 12rpx; }
.amt-num { font-size: 72rpx; color: var(--color-brand); font-weight: 600; line-height: 1; }

/* —— 数字键盘 3x4 —— */
.keypad {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 12rpx;
  margin-bottom: 24rpx;
}
.key {
  height: 96rpx;
  line-height: 96rpx;
  text-align: center;
  font-size: 36rpx;
  font-weight: 500;
  color: var(--color-ink);
  background-color: var(--color-bg, #FAF7F0);
  border-radius: 16rpx;
  transition: background-color 0.1s ease;
}
.key-fn { color: var(--color-brand); font-size: 40rpx; }
.key-hover { background-color: var(--color-brand-soft); }

/* —— 月度统计入口 —— */
.month-entry {
  display: flex;
  align-items: center;
  padding: 24rpx 28rpx;
  margin-top: 24rpx;
  background-color: var(--color-surface);
  border: 1rpx solid var(--color-border);
  border-radius: var(--radius-card);
}
.month-entry-hover { background-color: var(--color-brand-soft); }
.month-entry-label { flex: 1; font-size: 28rpx; color: var(--color-ink); }
.month-entry-value { font-size: 22rpx; color: var(--color-muted); }
.month-entry-arrow { margin-left: 12rpx; font-size: 32rpx; color: var(--color-muted); }

/* —— sheet 表单行 —— */
.form-row {
  display: flex;
  align-items: center;
  padding: 16rpx 0;
  border-bottom: 1rpx solid var(--color-divider);
}
.form-row:last-of-type { border-bottom: none; }
.form-label {
  width: 96rpx;
  font-size: 26rpx;
  color: var(--color-muted);
  flex-shrink: 0;
}
.form-input {
  flex: 1;
  height: 56rpx;
  font-size: 28rpx;
  color: var(--color-ink);
}

/* —— sheet 底部按钮 —— */
.sheet-actions {
  display: flex;
  gap: 16rpx;
  margin-top: 24rpx;
}
.sheet-btn {
  flex: 1;
  height: 88rpx;
  line-height: 88rpx;
  text-align: center;
  font-size: 28rpx;
  font-weight: 500;
  color: #FFFFFF;
  background-color: var(--color-brand);
  border-radius: 44rpx;
  transition: opacity 0.15s ease;
}
.sheet-btn.ghost {
  color: var(--color-ink);
  background-color: var(--color-bg, #FAF7F0);
}
.sheet-btn.danger {
  color: #FFFFFF;
  background-color: #B23A3A;
}
.sheet-btn:active { opacity: 0.75; }
