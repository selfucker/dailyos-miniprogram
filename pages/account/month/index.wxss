.page { padding: 16rpx 28rpx 40rpx; }

.month-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 16rpx 0 24rpx;
}
.nav {
  font-size: 26rpx;
  color: var(--color-brand);
  padding: 8rpx 16rpx;
  border-radius: var(--radius-pill);
}
.nav-hover { background-color: var(--color-brand-soft); }
.nav-off { color: var(--color-muted); opacity: 0.4; }
.month-title { font-size: 34rpx; font-weight: 600; color: var(--color-ink); }

.summary {
  display: flex;
  background-color: var(--color-surface);
  border: 1rpx solid var(--color-border);
  border-radius: var(--radius-card);
  padding: 28rpx 0;
  margin-bottom: 24rpx;
}
.sum-item { flex: 1; text-align: center; }
.sum-num { display: block; font-size: 30rpx; font-weight: 600; color: var(--color-ink); }
.sum-num.neg { color: var(--color-urgent, #B5482E); }
.sum-label { display: block; margin-top: 8rpx; font-size: 22rpx; color: var(--color-muted); }

.block {
  background-color: var(--color-surface);
  border: 1rpx solid var(--color-border);
  border-radius: var(--radius-card);
  padding: 28rpx 28rpx 20rpx;
  margin-bottom: 24rpx;
}
.block-title { font-size: 26rpx; color: var(--color-muted); margin-bottom: 20rpx; }

.cat-row { margin-bottom: 20rpx; }
.cat-head { display: flex; justify-content: space-between; align-items: baseline; margin-bottom: 10rpx; }
.cat-name { font-size: 28rpx; color: var(--color-ink); }
.cat-amt { font-size: 22rpx; color: var(--color-muted); }
.cat-track {
  height: 16rpx;
  background-color: var(--color-divider);
  border-radius: 8rpx;
  overflow: hidden;
}
.cat-fill {
  height: 100%;
  background-color: var(--color-brand);
  border-radius: 8rpx;
}

.days {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  height: 220rpx;
}
.day { flex: 1; display: flex; flex-direction: column; align-items: center; height: 100%; }
.day-bar-wrap {
  flex: 1;
  width: 60%;
  display: flex;
  align-items: flex-end;
  justify-content: center;
}
.day-bar {
  width: 100%;
  background-color: var(--color-brand);
  border-radius: 4rpx 4rpx 0 0;
  min-height: 2rpx;
}
.day-num { margin-top: 8rpx; font-size: 18rpx; color: var(--color-muted); }
.days-tip { margin-top: 16rpx; font-size: 20rpx; color: var(--color-muted); text-align: center; }

.empty { margin-top: 140rpx; text-align: center; }
.empty-title { font-size: 32rpx; font-weight: 600; color: var(--color-ink); }
.empty-sub { margin-top: 12rpx; font-size: 24rpx; color: var(--color-muted); }
